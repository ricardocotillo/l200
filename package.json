{
  "name": "l200-listing",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build:css && npm run build:js && npm run build:html",
    "build:css": "tailwindcss -i src/index.css -o dist/css/index.css --minify",
    "build:js": "esbuild src/index.js --bundle --minify --outfile=dist/js/index.js",
    "build:html": "mkdir -p dist && cp index.html dist/index.html",
    "watch:css": "tailwindcss -i src/index.css -o dist/css/index.css --watch",
    "watch:js": "esbuild src/index.js --bundle --outfile=dist/js/index.js --watch",
    "dev": "npm run watch:css & npm run watch:js"
  },
  "type": "commonjs",
  "private": "true",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19"
  }
}
